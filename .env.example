# Existing content sources
YOUTUBE_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
REDIS_URL=

# Sentry: project Settings > Client Keys (DSN).
# NEXT_PUBLIC_SENTRY_DSN is embedded in the browser bundle at build time.
# The server and Edge runtimes use this same DSN unless SENTRY_DSN overrides it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development

# Build-time source map upload credentials; never use a NEXT_PUBLIC_ token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional immutable release override; otherwise the build plugin uses the Git SHA.
SENTRY_RELEASE=

# Independent bearer token for POST /api/github/trigger
GITHUB_TRIGGER_SECRET=

# YouTube admission shared across workers (production requires REDIS_URL).
# Tune to your actual API quota; failed attempts also consume this budget.
YOUTUBE_REFRESH_INTERVAL_MS=1200000
YOUTUBE_MAX_REFRESHES_PER_DAY=90
# Test-only isolated Redis DB; never point this at app data.
# REDIS_TEST_URL=redis://127.0.0.1:6379/15
